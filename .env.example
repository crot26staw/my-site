# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Подключение к PostgreSQL: postgres://пользователь:пароль@хост:порт/база
# Локально — база из docker-compose.yml
DATABASE_URL=postgres://weblite:weblite_dev@127.0.0.1:5433/weblite

# Сайт стоит за nginx: адрес посетителя брать из заголовка X-Real-IP (только если nginx его выставляет).
# Без nginx (локально) — 0.
TRUST_PROXY=0

# Папка для загруженных картинок (вне репозитория). По умолчанию — storage/uploads в папке проекта.
# UPLOADS_DIR=/var/lib/web-lite/uploads

# Секрет приложения: шифрование ключей 2FA и хеширование IP в заявках и журнале.
# Длинная случайная строка: openssl rand -base64 32. После запуска не меняйте — 2FA у всех слетит.
APP_SECRET=

# Необязательно: письмо о новой заявке на почту, указанную в контактах сайта (раздел «Сайт» в админке).
# Отправляется первым, затем — сообщение в Telegram. Без SMTP_HOST письма не отправляются.
# Порт 465 — TLS, 587 — STARTTLS. Пример для Яндекса: smtp.yandex.ru, 465, пароль приложения.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# Отправитель; по умолчанию SMTP_USER. Почтовые сервисы обычно разрешают только адрес самого ящика.
# SMTP_FROM="Web-Lite <robot@example.com>"

# Необязательно: уведомления о новых заявках в Telegram (группа: добавьте бота в неё, CHAT_ID начинается с -100)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
